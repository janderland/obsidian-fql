{
  "name": "obsidian-fql",
  "version": "0.1.0",
  "description": "Syntax highlighting for FQL (FoundationDB query language) code blocks in Obsidian.",
  "main": "main.js",
  "scripts": {
    "grammar": "lezer-generator src/fql.grammar -o src/parser/fql.parser",
    "dev": "npm run grammar && node esbuild.config.mjs",
    "build": "npm run grammar && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "fql",
    "foundationdb",
    "syntax-highlighting",
    "lezer"
  ],
  "author": "Jon Anderson",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.23.0",
    "@lezer/common": "^1.2.0",
    "@lezer/generator": "^1.7.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "@types/node": "^20.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.3.0"
  }
}
